{
  "manifest_version": 3,
  "name": "Kpoparkive Namu Capture",
  "version": "0.9.0",
  "description": "Raw-first NamuWiki capture with resumable Raw Crawl, verification pause/resume, template reuse, asset recovery, and fidelity debugging.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://namu.wiki/*",
    "https://*.namu.wiki/*",
    "https://*/*",
    "http://127.0.0.1:43117/*",
    "http://127.0.0.1:43119/*",
    "http://127.0.0.1:43120/*"
  ],
  "action": {
    "default_title": "Import NamuWiki cluster",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background-controller.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://namu.wiki/w/*",
        "https://www.namu.wiki/w/*"
      ],
      "js": [
        "ad-filter.js",
        "content.js",
        "raw-file-media.js",
        "rendered-dom.js",
        "rendered-root-guard.js",
        "links.js",
        "fidelity-capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kpoparkive.vercel.app/admin/thetree-frontend-poc/*"
      ],
      "js": [
        "fidelity-capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://namu.wiki/edit/*",
        "https://www.namu.wiki/edit/*",
        "https://namu.wiki/new_edit_request/*",
        "https://www.namu.wiki/new_edit_request/*"
      ],
      "js": [
        "edit-source.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
