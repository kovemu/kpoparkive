{
  "manifest_version": 3,
  "name": "Kpoparkive Namu Capture",
  "version": "0.5.0",
  "description": "Capture and recursively clone rendered NamuWiki document clusters with verified media from normal Chrome.",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "https://namu.wiki/*",
    "https://*.namu.wiki/*",
    "https://*/*",
    "http://127.0.0.1:43117/*"
  ],
  "action": {
    "default_title": "Capture NamuWiki page",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://namu.wiki/w/*", "https://www.namu.wiki/w/*"],
      "js": ["content.js", "rendered-dom.js", "links.js"],
      "run_at": "document_idle"
    }
  ]
}
