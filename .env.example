# Kpoparkive local development / post-collection pipeline
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
KPOPARKIVE_ADMIN_KEY=YOUR_LOCAL_ADMIN_KEY

# Required for automatic English translation after extension capture is complete.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Optional. Default policy is Luna -> Terra -> Sol on retries.
# KPOPARKIVE_TRANSLATION_MODEL=gpt-5.6-luna

# Optional local workspace for translation checkpoints/logs.
# Windows example:
# KPOPARKIVE_DATA_DIR=D:\kpoparkive-data
